# ==============================================================================
# GrowMate AI — Environment Configuration
# Hacktoberfest Open-Source AI Challenge: Week 1 "Touch Grass"
# ==============================================================================

# Core AI Provider ("google_gemini" | "huggingface" | "deterministic_rules")
VITE_AI_PROVIDER=google_gemini

# Google API Key (Provides access to Google Gemini 1.5 Flash / Gemma 2 via Google AI Studio)
# Get a free key at: https://aistudio.google.com/
VITE_GOOGLE_API_KEY=

# Open-Weight AI Model via Hugging Face Serverless API (Alternative open-weight provider)
# Free serverless inference without downloading local weights!
VITE_HF_API_TOKEN=
VITE_HF_MODEL=google/gemma-2-9b-it

# Weather Provider ("open_meteo" is 100% free with no API key required)
VITE_WEATHER_PROVIDER=open_meteo

# Map Provider ("openstreetmap" is 100% free with no API key; "google_maps" requires key below)
VITE_MAPS_PROVIDER=openstreetmap
VITE_GOOGLE_MAPS_API_KEY=

# App Name & Branding
VITE_APP_NAME="GrowMate AI"
VITE_APP_MISSION="Grow More. Waste Less. Touch Grass."
